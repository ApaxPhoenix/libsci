# clang-tidy over libsci's own sources, for bugs rather than style: the Clang
# Static Analyzer, the bug-prone patterns, and what costs time for nothing.
# Slang's, Vulkan's and asmjit's sources are theirs, and only libsci's own headers are checked.
# `cmake --preset analyze` builds with these checks on.
#
# Left out, each for what it would flag here and nowhere else:
#   bugprone-easily-swappable-parameters: shapes, strides and offsets are integers side by side, as the kernels take them.
#   bugprone-narrowing-conversions: element counts narrow to the GPU's 32-bit indices on purpose, checked where made.
#   bugprone-implicit-widening-of-multiplication-result: the same element counts, as above.
#   performance-enum-size: the enums are a handful of values, never stored in bulk.
#   clang-analyzer-optin.performance.Padding: Vulkan's structs and the kernels' arguments are laid out as the GPU reads them.
Checks: >
  -*,
  clang-analyzer-*,
  -clang-analyzer-optin.performance.Padding,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-implicit-widening-of-multiplication-result,
  performance-*,
  -performance-enum-size,
  misc-redundant-expression,
  readability-misleading-indentation,
  readability-suspicious-call-argument
HeaderFilterRegex: '.*/libsci/(include|src)/.*'
ExcludeHeaderFilterRegex: '.*/(vendors|cmake-build-[^/]*)/.*'
WarningsAsErrors: ''
